$env:HIL_PUBLIC_DASH_USER = "change-me"
$env:HIL_PUBLIC_DASH_PASS = "change-me"
# Optional: preload Istentore API password at startup.
$env:HIL_API_PASSWORD = "change-me"
# Optional: avoids Flask session warnings when public basic auth is enabled.
$env:HIL_FLASK_SECRET_KEY = "change-me-to-a-long-random-string"
